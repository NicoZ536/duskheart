{
  "name": "duskhearth",
  "private": true,
  "version": "0.1.0",
  "description": "DUSKHEARTH – 2D-Top-Down-Survival im Browser (16-Bit-Pixelart × moderne Shader-Pipeline)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && npm run typecheck && vite build",
    "preview": "vite preview",
    "assets": "tsx tools/assets/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "forbidden": "tsx tools/forbidden.ts",
    "test:unit": "vitest run --project unit --reporter=dot",
    "test:integration:fast": "vitest run --project integration-fast --reporter=dot --passWithNoTests",
    "test:integration": "vitest run --project integration --reporter=dot --passWithNoTests",
    "check": "tsx tools/check.ts",
    "test:e2e": "playwright test --reporter=dot",
    "shot": "tsx tools/shot.ts",
    "bench": "node --expose-gc --import tsx tools/bench.ts",
    "validate:content": "tsx tools/validate-content.ts",
    "verify": "npm run check && npm run test:integration && npm run build && npm run test:e2e && npm run bench"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.2.7",
    "@preact/signals": "2.11.2",
    "preact": "10.29.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  }
}
